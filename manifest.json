{
  "manifest_version": 3,
  "name": "MintList New Tab",
  "description": "A private, polished new-tab bookmark workspace with freeform boards, search, wallpapers, backups, and privacy controls.",
  "version": "1.4.0",
  "permissions": ["storage", "tabs", "identity", "identity.email", "unlimitedStorage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "incognito": "split",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MintList",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
