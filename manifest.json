{
  "manifest_version": 3,
  "name": "MintList New Tab",
  "description": "A free smart new-tab bookmark manager with freeform boards, wallpapers, privacy blur, quick search, Google profile sign-in, and incognito opening.",
  "version": "1.3.0",
  "permissions": ["storage", "tabs", "identity", "identity.email", "unlimitedStorage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "incognito": "split",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MintList",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}